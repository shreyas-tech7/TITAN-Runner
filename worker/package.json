{
  "name": "titan-runner-brain",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker: 1-minute cron coordinator for TITAN-Runner's always-on sub-agent cluster. Reads/writes D1 only; never touches state/ or the private TITAN repo.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.mjs"
  },
  "dependencies": {
    "tweetnacl-sealedbox-js": "^1.2.0",
    "tweetnacl": "^1.0.3",
    "blakejs": "^1.2.1"
  },
  "devDependencies": {
    "wrangler": "^4.132.0",
    "libsodium-wrappers": "^0.7.15"
  }
}
