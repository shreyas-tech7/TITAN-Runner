# TITAN-Runner — environment example (no secrets).
#
# Every value here is optional. A missing provider key makes that provider
# report not_configured; it never crashes the pulse. In GitHub Actions these
# are set as repository secrets (Settings -> Secrets and variables -> Actions)
# and injected as env vars in .github/workflows/titan-pulse.yml — they are
# never committed, never logged, and scrubbed from anything written to state/
# (see src/lib/redact.js and scripts/check-secrets-in-state.mjs).

# Model providers. Every value is optional. The pulse degrades gracefully without a key.
# The list below is generated from config/providers.catalog.json.
# BEGIN provider secrets (generated from config/providers.catalog.json, run npm run sync:providers)
#
# Groq (groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Together AI (together). Get a key at https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=
# OpenRouter (openrouter). Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Google Gemini (gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# Hugging Face (huggingface). Get a key at https://huggingface.co/settings/tokens
# The real environment variable is HF_API_KEY, not HUGGINGFACE_API_KEY.
HF_API_KEY=
HF_MODEL=
# OpenCode Zen (opencode). Get a key at https://opencode.ai/auth
# Optional. The base URL defaults to OpenCode Zen.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=
# OmniRoute gateway (omniroute). Get a key at https://github.com/diegosouzapw/OmniRoute
# Optional. When a base URL is set, the registry tries OmniRoute first. Leave all three empty to turn it off.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
# Hermes agent 1 (hermes_1). Get a key at https://github.com/NousResearch/hermes-agent
HERMES_1_API_KEY=
HERMES_1_BASE_URL=
HERMES_1_MODEL=
HERMES_1_CHAT_PATH=
HERMES_1_SPECIALIZATION=
# Hermes agent 2 (hermes_2). Get a key at https://github.com/NousResearch/hermes-agent
HERMES_2_API_KEY=
HERMES_2_BASE_URL=
HERMES_2_MODEL=
HERMES_2_CHAT_PATH=
HERMES_2_SPECIALIZATION=
# Hermes agent 3 (hermes_3). Get a key at https://github.com/NousResearch/hermes-agent
HERMES_3_API_KEY=
HERMES_3_BASE_URL=
HERMES_3_MODEL=
HERMES_3_CHAT_PATH=
HERMES_3_SPECIALIZATION=
# Freebuff (freebuff). Get a key at https://freebuff.com
# Freebuff has no public API. TITAN reads this key and never uses it for a live call.
FREEBUFF_API_KEY=
# Custom provider 1 (custom_1)
CUSTOM_1_API_KEY=
CUSTOM_1_BASE_URL=
CUSTOM_1_MODEL=
CUSTOM_1_LABEL=
# Custom provider 2 (custom_2)
CUSTOM_2_API_KEY=
CUSTOM_2_BASE_URL=
CUSTOM_2_MODEL=
CUSTOM_2_LABEL=
# Custom provider 3 (custom_3)
CUSTOM_3_API_KEY=
CUSTOM_3_BASE_URL=
CUSTOM_3_MODEL=
CUSTOM_3_LABEL=
# END provider secrets

# GitHub — set automatically to the workflow's own GITHUB_TOKEN in CI. Only
# needed locally if you want to exercise issue sync against a real repo.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# Orchestrator tuning.
TITAN_MAX_TASKS_PER_PULSE=3
TITAN_MAX_SUBTASKS_PER_RUN=8
TITAN_TASK_TIMEOUT_MS=120000

# Reviewer / safety gate (default ON in this repo — see docs/RUNTIME.md).
TITAN_REVIEWER=1
TITAN_REVIEWER_TIMEOUT_MS=8000

# Set to 1 to run the pulse against fixtures only, with zero network calls
# and zero GitHub writes — see docs/RUNTIME.md's "Try it locally" section.
TITAN_DRY_RUN=0

# ---- Engine controls (all optional; defaults in docs/CONFIG.md) ---------------
# Who may file tasks besides the owner and GitHub-verified collaborators.
TITAN_TASK_AUTHORS=
# Hosts the http_fetch tool may reach (empty = nothing). `.example.com` allows subdomains.
TITAN_EGRESS_ALLOWLIST=
# Verification: TITAN_VERIFY_JUDGE=0 skips the judge model; TITAN_VERIFY_STRICT=1 fails an unjudged run.
TITAN_VERIFY_JUDGE=
TITAN_VERIFY_STRICT=
# Budgets: per task and per pulse. See docs/CONFIG.md for every TITAN_* variable.
TITAN_TASK_MAX_MODEL_CALLS=
TITAN_PULSE_MAX_MODEL_CALLS=

# Daily research digest (src/research/dailyResearch.js, config/research-topics.yml).
# On by default: once per UTC day, one low-priority call to a free provider,
# written to state/digests/<date>-research.md. Set TITAN_RESEARCH=0 to turn it
# off. Skipped silently when every provider is rate-limited or unconfigured;
# a failed attempt is retried no sooner than this many minutes (default 180).
TITAN_RESEARCH=
TITAN_RESEARCH_RETRY_MINUTES=

# Hermes agent cluster (src/orchestrator/hermesCluster.js) — CLIENT CODE ONLY.
# 2-3 Hermes Agent instances, run as separate services (the plan is Railway),
# each with its own URL and key. Nothing in the pulse calls them yet and no
# instance exists yet; these are the names to use as GitHub Actions secrets
# once they do. Leave empty and the cluster simply does not exist.
#   - BASE_URL must be https (http only for localhost) with no credentials in it.
#   - An instance with no API_KEY is never called (an unauthenticated agent
#     endpoint is not something this repo will talk to).
#   - SPECIALIZATION: comma-separated task aspects from
#     src/orchestrator/taxonomy.js (architecture, code-generation, refactoring,
#     testing, debugging, documentation, security-review, performance,
#     data-modeling, devops, ui-implementation, research). Empty = generalist.
#   - MODEL and CHAT_PATH are optional (defaults: hermes-agent, /v1/chat/completions).
# Check a freshly provisioned instance with: node bin/titan.js hermes ping
HERMES_1_BASE_URL=
HERMES_1_API_KEY=
HERMES_1_SPECIALIZATION=
HERMES_1_MODEL=
HERMES_1_CHAT_PATH=
HERMES_2_BASE_URL=
HERMES_2_API_KEY=
HERMES_2_SPECIALIZATION=
HERMES_2_MODEL=
HERMES_2_CHAT_PATH=
HERMES_3_BASE_URL=
HERMES_3_API_KEY=
HERMES_3_SPECIALIZATION=
HERMES_3_MODEL=
HERMES_3_CHAT_PATH=
