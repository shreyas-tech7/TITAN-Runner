{
  "name": "titan-runner",
  "version": "1.0.0",
  "description": "Free, zero-maintenance GitHub Actions pulse runner for TITAN's multi-agent orchestrator.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pulse": "node src/pulse.js",
    "pulse:dry": "TITAN_DRY_RUN=1 node src/pulse.js",
    "simulate": "node bin/titan.js simulate",
    "doctor": "node bin/titan.js doctor",
    "bench": "node --max-old-space-size=512 bench/harness.mjs",
    "test": "node --test test/*.test.js",
    "check:denylist": "node scripts/check-denylist.mjs",
    "check:secrets": "node scripts/check-secrets-in-state.mjs",
    "check:secrets:diff": "node scripts/check-secrets-in-diff.mjs --staged",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:schemas": "node scripts/export-schemas.mjs --check",
    "schemas": "node scripts/export-schemas.mjs",
    "test:worker": "cd worker && npm test --silent",
    "check:ste": "node scripts/check-ste.mjs --base origin/main",
    "check:providers": "node scripts/check-provider-catalog.mjs",
    "sync:providers": "node scripts/sync-provider-env.mjs",
    "gen:migrations": "node scripts/gen-worker-migrations.mjs",
    "check:migrations": "node scripts/gen-worker-migrations.mjs --check",
    "check:test-mode": "node scripts/check-test-mode.mjs",
    "check:all": "node scripts/check-all.mjs"
  },
  "license": "MIT",
  "bin": {
    "titan": "bin/titan.js"
  }
}
