{
  "id": "notion",
  "name": "Notion",
  "icon": "NO",
  "version": "1.0.0",
  "category": "productivity",
  "description": "Search pages, read a page, query a database, and append text to a page.",
  "docsUrl": "https://developers.notion.com/reference/intro",
  "getKeyUrl": "https://www.notion.so/profile/integrations",
  "apiVersion": "Notion-Version 2022-06-28. The latest is 2026-03-11.",
  "auth": {
    "kind": "bearer",
    "setupNote": "Make an internal integration. Copy its secret. Open each page or database that TITAN may use, choose Connections, and add the integration.",
    "fields": [
      {
        "name": "token",
        "label": "Integration secret",
        "secret": true,
        "pattern": "^(ntn_|secret_)[A-Za-z0-9]{20,}$",
        "help": "It starts with ntn_."
      }
    ]
  },
  "egress": [
    "api.notion.com"
  ],
  "test": {
    "mode": "request",
    "request": {
      "method": "GET",
      "url": "https://api.notion.com/v1/users/me",
      "headers": {
        "Notion-Version": "2022-06-28"
      }
    },
    "expect": {
      "status": [
        200
      ],
      "pick": [
        "name",
        "type",
        "bot.workspace_name"
      ]
    }
  },
  "actions": [
    {
      "id": "search",
      "title": "Search",
      "risk": "read",
      "dataClass": "personal",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        },
        "required": []
      },
      "request": {
        "method": "POST",
        "url": "https://api.notion.com/v1/search",
        "headers": {
          "Notion-Version": "2022-06-28"
        },
        "body": {
          "query": "{{input.query}}",
          "page_size": "{{input.limit}}"
        }
      },
      "pick": [
        "results[].object",
        "results[].id",
        "results[].url",
        "results[].last_edited_time",
        "results[].title[].plain_text"
      ],
      "rateLimit": {
        "perMinute": 30
      }
    },
    {
      "id": "get_page",
      "title": "Get a page",
      "risk": "read",
      "dataClass": "personal",
      "input": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{32,36}$"
          }
        },
        "required": [
          "page_id"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://api.notion.com/v1/pages/{{input.page_id}}",
        "headers": {
          "Notion-Version": "2022-06-28"
        }
      },
      "pick": [
        "id",
        "url",
        "archived",
        "last_edited_time",
        "properties"
      ],
      "rateLimit": {
        "perMinute": 30
      }
    },
    {
      "id": "query_database",
      "title": "Query a database",
      "risk": "read",
      "dataClass": "personal",
      "input": {
        "type": "object",
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{32,36}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": [
          "database_id"
        ]
      },
      "request": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/{{input.database_id}}/query",
        "headers": {
          "Notion-Version": "2022-06-28"
        },
        "body": {
          "page_size": "{{input.limit}}"
        }
      },
      "pick": [
        "results[].id",
        "results[].url",
        "results[].last_edited_time",
        "results[].properties"
      ],
      "rateLimit": {
        "perMinute": 30
      }
    },
    {
      "id": "append_text",
      "title": "Append text to a page",
      "risk": "write",
      "dataClass": "personal",
      "input": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{32,36}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1900
          }
        },
        "required": [
          "page_id",
          "text"
        ]
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.notion.com/v1/blocks/{{input.page_id}}/children",
        "headers": {
          "Notion-Version": "2022-06-28"
        },
        "body": {
          "children": [
            {
              "object": "block",
              "type": "paragraph",
              "paragraph": {
                "rich_text": [
                  {
                    "type": "text",
                    "text": {
                      "content": "{{input.text}}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "pick": [
        "results[].id",
        "results[].type"
      ],
      "rateLimit": {
        "perMinute": 10
      }
    }
  ]
}
