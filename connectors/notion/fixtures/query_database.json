{
  "name": "query a database",
  "target": "action:query_database",
  "connection": {
    "config": {},
    "secrets": {
      "token": "@@FAKE:notion_token@@"
    }
  },
  "input": {
    "database_id": "0123456789abcdef0123456789abcdef"
  },
  "expect": {
    "request": {
      "method": "POST",
      "url": "https://api.notion.com/v1/databases/0123456789abcdef0123456789abcdef/query",
      "headers": {
        "Authorization": "Bearer @@FAKE:notion_token@@",
        "Notion-Version": "2022-06-28"
      },
      "body": {
        "page_size": 10
      }
    },
    "hosts": []
  },
  "response": {
    "status": 200,
    "contentType": "application/json",
    "body": {
      "results": [
        {
          "id": "r1",
          "url": "https://notion.so/r1",
          "last_edited_time": "2026-10-03T00:00:00Z",
          "properties": {
            "Status": {
              "select": {
                "name": "Done"
              }
            }
          },
          "created_by": {}
        }
      ]
    }
  },
  "output": {
    "results": [
      {
        "id": "r1",
        "url": "https://notion.so/r1",
        "last_edited_time": "2026-10-03T00:00:00Z",
        "properties": {
          "Status": {
            "select": {
              "name": "Done"
            }
          }
        }
      }
    ]
  }
}
