{
  "name": "append text",
  "target": "action:append_text",
  "connection": {
    "config": {},
    "secrets": {
      "token": "@@FAKE:notion_token@@"
    }
  },
  "input": {
    "page_id": "0123456789abcdef0123456789abcdef",
    "text": "Hello"
  },
  "expect": {
    "request": {
      "method": "PATCH",
      "url": "https://api.notion.com/v1/blocks/0123456789abcdef0123456789abcdef/children",
      "headers": {
        "Authorization": "Bearer @@FAKE:notion_token@@",
        "Notion-Version": "2022-06-28"
      },
      "body": {
        "children": [
          {
            "object": "block",
            "type": "paragraph",
            "paragraph": {
              "rich_text": [
                {
                  "type": "text",
                  "text": {
                    "content": "Hello"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "hosts": []
  },
  "response": {
    "status": 200,
    "contentType": "application/json",
    "body": {
      "results": [
        {
          "id": "b1",
          "type": "paragraph",
          "paragraph": {}
        }
      ]
    }
  },
  "output": {
    "results": [
      {
        "id": "b1",
        "type": "paragraph"
      }
    ]
  }
}
