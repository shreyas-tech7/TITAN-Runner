{
  "name": "list closed pull requests",
  "target": "action:list_prs",
  "connection": {
    "config": {
      "owner": "shreyas-tech7",
      "repo": "TITAN-Runner"
    },
    "secrets": {
      "token": "@@FAKE:github_token@@"
    }
  },
  "input": {
    "state": "closed",
    "limit": 1
  },
  "expect": {
    "request": {
      "method": "GET",
      "url": "https://api.github.com/repos/shreyas-tech7/TITAN-Runner/pulls?state=closed&per_page=1",
      "headers": {
        "Authorization": "Bearer @@FAKE:github_token@@",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "body": null
    },
    "hosts": []
  },
  "response": {
    "status": 200,
    "contentType": "application/json",
    "body": [
      {
        "number": 28,
        "title": "Wave 12",
        "state": "closed",
        "html_url": "https://github.com/x/y/pull/28",
        "user": {
          "login": "alice"
        },
        "draft": false,
        "updated_at": "2026-10-08T00:00:00Z",
        "head": {
          "ref": "wave-12",
          "sha": "abc"
        }
      }
    ]
  },
  "output": [
    {
      "number": 28,
      "title": "Wave 12",
      "state": "closed",
      "html_url": "https://github.com/x/y/pull/28",
      "user": {
        "login": "alice"
      },
      "draft": false,
      "updated_at": "2026-10-08T00:00:00Z",
      "head": {
        "ref": "wave-12"
      }
    }
  ]
}
