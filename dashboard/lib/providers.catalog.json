    {
      "id": "gemini",
      "label": "Google Gemini",
      "kind": "llm",
      "verifiable": true,
      "usedBy": [
        "pulse",
        "subagent",
        "chat"
      ],
      "failover": "direct",
      "secrets": {
        "key": "GEMINI_API_KEY",
        "model": "GEMINI_MODEL"
      },
      "inputs": {
        "model": {
          "required": false,
          "help": "Leave empty to use the model that the self-test found."
        }
      },
      "keyHint": {
        "prefixes": [
          "AIza"
        ],
        "text": "A Gemini key starts with AIza."
      },
      "validate": {
        "method": "GET",
        "url": "https://generativelanguage.googleapis.com/v1beta/models",
        "auth": {
          "style": "header",
          "name": "x-goog-api-key"
        },
        "ok": [
          200
        ],
        "rejected": [
          401,
          403
        ],
        "rejectedWhen": [
          {
            "status": 400,
            "bodyIncludes": "API_KEY_INVALID"
          }
        ],
        "source": "https://ai.google.dev/api/models",
        "checkedOn": "2026-10-08",
        "note": "Gemini answers 400 INVALID_ARGUMENT, not 401, for a bad key. A live probe on 2026-10-08 showed this. The key goes in a header and not in the query string."
      },
      "chat": {
        "style": "gemini",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "path": "/models/{model}:generateContent",
        "streamPath": "/models/{model}:streamGenerateContent?alt=sse",
        "defaultModel": "gemini-2.5-flash"
      },
      "getKeyUrl": "https://aistudio.google.com/apikey",
      "noCard": true,
      "freeTierNote": {
        "text": "Gemini has a free tier. The limits for each model are in Google AI Studio. The docs say billing is needed only to move to a paid tier.",
        "source": "https://ai.google.dev/gemini-api/docs/rate-limits",
        "checkedOn": "2026-10-08"
      }
    },
