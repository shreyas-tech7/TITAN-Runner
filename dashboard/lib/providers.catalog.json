      },
      "validate": {
        "method": "GET",
        "url": "https://api.together.xyz/v1/models",
        "auth": {
          "style": "bearer"
        },
        "ok": [
          200
        ],
        "rejected": [
          401,
          403
        ],
        "source": "https://docs.together.ai/reference/models-1",
        "checkedOn": "2026-10-08",
        "note": "A fake key returned 401 in a live probe on 2026-10-08."
      },
      "chat": {
        "style": "openai",
        "baseUrl": "https://api.together.xyz/v1",
        "path": "/chat/completions",
        "defaultModel": "meta-llama/Llama-3.3-70B-Instruct-Turbo-Free"
      },
      "getKeyUrl": "https://api.together.ai/settings/api-keys",
      "noCard": false,
      "freeTierNote": {
        "text": "Together AI has no free trial now. Its support page says a purchase of at least 5 dollars is required. This does not fit the zero cost rule. Add a key only if you already have credit.",
