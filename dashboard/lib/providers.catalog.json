{
  "schemaVersion": 1,
  "updated": "2026-10-08",
  "about": "The one source of truth for model providers. The Worker, the dashboard, the pulse, .env.example, and the workflow env maps must agree with this file. scripts/check-provider-catalog.mjs checks that. The order of this list is the failover order for chat.",
  "providers": [
    {
      "id": "groq",
      "label": "Groq",
      "kind": "llm",
      "verifiable": true,
      "usedBy": [
        "pulse",
        "subagent",
        "chat"
      ],
      "failover": "direct",
      "secrets": {
        "key": "GROQ_API_KEY",
        "model": "GROQ_MODEL"
      },
      "inputs": {
        "model": {
          "required": false,
          "help": "Leave empty to use the model that the self-test found."
        }
      },
      "keyHint": {
        "prefixes": [
          "gsk_"
        ],
        "text": "A Groq key starts with gsk_."
      },
      "validate": {
        "method": "GET",
        "url": "https://api.groq.com/openai/v1/models",
        "auth": {
          "style": "bearer"
        },
        "ok": [
          200
        ],
        "rejected": [
          401,
          403
        ],
        "source": "https://console.groq.com/docs/api-reference",
        "checkedOn": "2026-10-08",
        "note": "A fake key returned 401 invalid_api_key in a live probe on 2026-10-08."
      },
      "chat": {
        "style": "openai",
        "baseUrl": "https://api.groq.com/openai/v1",
        "path": "/chat/completions",
        "defaultModel": "llama-3.3-70b-versatile"
      },
      "getKeyUrl": "https://console.groq.com/keys",
      "noCard": true,
      "freeTierNote": {
        "text": "Groq has a free plan. The limits are in the Groq console. The docs page does not state the numbers for each model.",
        "source": "https://console.groq.com/docs/rate-limits",
        "checkedOn": "2026-10-08"
      }
    },
    {
